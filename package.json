{
  "name": "angular-foundations-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Laboratorio progresivo para aprender Angular antes de abordar una aplicación CRUD completa.",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "api": "node server/index.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:exercise": "node scripts/test-exercise.mjs",
    "list": "node scripts/list.mjs",
    "check": "node scripts/verify-structure.mjs",
    "verify": "npm run check && npm run build && npm run test && npm run test:server",
    "test:server": "node --test tests/server.smoke.test.mjs"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0",
    "npm": ">=10.9.0"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "jsdom": "30.1.2",
    "typescript": "~6.0.2",
    "vitest": "5.0.4"
  }
}
